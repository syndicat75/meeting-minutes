# OPENAI_API_KEY: Required for OpenAI primary transcription API.
# Configurable in Vercel / Cloud Run environment variables. Never expose to client browser.
OPENAI_API_KEY=""

# OPENAI_TRANSCRIBE_MODEL: OpenAI Transcription & Speaker Diarization Model (Default: gpt-4o-transcribe-diarize)
OPENAI_TRANSCRIBE_MODEL="gpt-4o-transcribe-diarize"

# OPENAI_CORRECTION_MODEL: OpenAI model for context and typo correction (Default: gpt-4o-mini)
OPENAI_CORRECTION_MODEL="gpt-4o-mini"

# AI_PRIMARY_PROVIDER: Primary AI transcription provider (Default: openai)
AI_PRIMARY_PROVIDER="openai"

# AI_FALLBACK_PROVIDER: Fallback AI transcription provider on temporary outage (Default: gemini)
AI_FALLBACK_PROVIDER="gemini"

# GEMINI_API_KEY: Required for Gemini AI fallback & meeting summarization.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Gemini AI Model name (Default: gemini-3.6-flash)
GEMINI_MODEL="gemini-3.6-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
