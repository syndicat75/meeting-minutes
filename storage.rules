rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // 회의 관련 저장소 규칙: meetings/{meetingId}/...
    match /meetings/{meetingId} {
      
      // 1. 5분 단위 오디오 청크 분할 저장소 (명시적 경로 매칭)
      // 실제 업로드 경로: meetings/{meetingId}/audio/chunks/chunk_0001.webm
      match /audio/chunks/{fileName} {
        allow read, write: if request.auth != null;
      }

      // 2. 오디오 청크 및 기타 오디오 하위 경로 전체
      match /audio/{allPaths=**} {
        allow read, write: if request.auth != null;
      }

      // 3. 단일 녹음 파일 (최대 200MB)
      match /recordings/{fileName} {
        allow read, write: if request.auth != null;
      }

      // 4. 회의 현장 사진 (최대 15MB, 이미지)
      match /photos/{fileName} {
        allow read, write: if request.auth != null;
      }

      // 5. 참석자 전자서명 이미지 (최대 5MB)
      match /signatures/{fileName} {
        allow read, write: if request.auth != null;
      }
    }
  }
}

